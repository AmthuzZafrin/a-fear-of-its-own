# Public repository of Paper 1. Everything is ignored except what the paper reports or needs (see README.md).
/*
!/.gitignore
!/README.md
!/REPRODUCE.md
!/HYPOTHESES.md
!/verify_freeze.py
!/reproduce_headlines.sh
!/reproduce_figures.sh
!/analyze.py
!/analyze_stage3.py
!/analyze_stage4.py
!/analyze_u*.py
!/decode_split.py
!/make_appendix.py
!/make_fig*.py
!/pick_bonus.py
!/pilot_bonus.py
!/relabel_score_cheap.py
!/run_all.sh
!/run_probes.sh
!/run_upgrade_u1.sh
!/run_upgrade_u1_analysis.sh
!/run_u*.sh
!/run_pilot_bonus.sh
!/vw/
!/results/
!/results_reproduced_*/
!/runs/
!/runs_pilot/
!/runs_therapy/
!/figures/
!/paper/

__pycache__/
*.pyc

# material for a later study (structural measures of feeling, empathy, scaling)
/vw/structure.py
/vw/theories.py
/vw/social.py
/vw/scaling.py
/results/part2.*
/results/part3.*
/results/theories.*
/results/**/capacity.json
/results/**/part2.*
/results/**/part3.*
/results/**/theories.*
/results/with_part3/
/runs/social_tau12_s*/
/runs/mortal_tau12_h*_s*/
/runs/**/structure*.json
/runs/**/theories*.json
/runs/**/scaling.json
/runs/**/social.json

# only the paper's own figures
/figures/*
!/figures/fig2_persistence.png
!/figures/fig3_conditions.png
!/figures/fig4_tradeoff.png
!/figures/fig5_causal.png
!/figures/fig13_vulnerability.png
!/figures/fig14_affectfit.png
!/figures/fig30_beliefstakes.png
!/figures/fig31_offswitch.png
!/figures/fig32_batch2.png
!/figures/fig33_longer.png

# only the paper source, the PDF and the freeze record
/paper/*
!/paper/paper.tex
!/paper/appendix_outcomes.tex
!/paper/appendix_results.tex
!/paper/paper.pdf
!/paper/upgrade_freeze/
